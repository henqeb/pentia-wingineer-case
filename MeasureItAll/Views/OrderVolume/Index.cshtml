@model IReadOnlyList<MonthlyOrderVolumeModel>
@{
    ViewData["Title"] = "Order volume";
}

<h1>Order volume per month</h1>

@if (Model.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <ul>
        @foreach (var monthlyOrderVolume in Model)
        {
            <li>@monthlyOrderVolume.MonthName @monthlyOrderVolume.Year: @monthlyOrderVolume.OrderCount orders</li>
        }
    </ul>
}
