@model IReadOnlyList<SalesPersonOrderCountModel>
@{
    ViewData["Title"] = "Measure it all";
}

<h1>Measure it all</h1>

@if (Model.Count == 0)
{
    <p>No salespeople found.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Order count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var salesPersonOrderCount in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="SalesPerson" asp-action="Details" asp-route-id="@salesPersonOrderCount.SalesPersonId">@salesPersonOrderCount.Name</a>
                    </td>
                    <td>@salesPersonOrderCount.OrderCount</td>
                </tr>
            }
        </tbody>
    </table>
}
